<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared by every service through common-lib. %mask(...) also covers stack traces. -->
<configuration>
    <conversionRule conversionWord="mask" converterClass="com.swiftdrop.common.logging.MaskingConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%X{requestId:-}] %logger{36} - %mask(%msg%n%ex)</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
