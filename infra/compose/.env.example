# SwiftDrop local environment. Copy to .env (never commit .env):
#   cp .env.example .env && ../../scripts/dev-keys.sh
# dev-keys.sh fills every empty secret below with a random value and generates the JWT keypair.

# ---------- PostgreSQL ----------
POSTGRES_DB=swiftdrop
POSTGRES_USER=postgres
# Superuser password (only used by the init script and for admin access)
POSTGRES_PASSWORD=
# One login per service; each owns its own schema (auth, parcel, dispatch, merchant, notification)
AUTH_DB_PASSWORD=
PARCEL_DB_PASSWORD=
DISPATCH_DB_PASSWORD=
MERCHANT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# ---------- RabbitMQ (management UI: http://localhost:15672) ----------
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=

# ---------- MinIO (console: http://localhost:9001) ----------
MINIO_ROOT_USER=swiftdrop
# At least 8 characters
MINIO_ROOT_PASSWORD=

# ---------- Auth: JWT ----------
# RS256 keypair as base64-encoded PEM (private key in PKCS#8). Generated by scripts/dev-keys.sh.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Issuer written into tokens and checked by every service
JWT_ISSUER=http://auth-service:8081
# ISO-8601 durations. Set JWT_ACCESS_TTL=PT1M to test silent refresh.
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# ---------- Auth: PII encryption ----------
# Base64 of 32 random bytes (AES-256-GCM key for phone numbers and the OAuth state cookie)
PII_ENCRYPTION_KEY=

# ---------- Auth: cookies and web app ----------
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
# Public URL of the web app; Google redirects back to ${WEB_APP_URL}/api/v1/auth/oauth2/callback/google
WEB_APP_URL=http://localhost:3000

# ---------- Auth: Google OAuth (optional for local dev) ----------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Demo data ----------
# true creates one account per role on startup (admin@swiftdrop.test, ...). Never enable in production.
SEED_DEMO_DATA=true
# Password for every seeded account (dev-keys.sh generates one and prints it)
SEED_PASSWORD=
