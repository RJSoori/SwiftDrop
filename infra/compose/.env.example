# SwiftDrop local environment. Copy to .env (never commit .env):
#   cp .env.example .env && ../../scripts/dev-keys.sh
# dev-keys.sh fills every empty secret below with a random value and generates the JWT keypair.

# ---------- PostgreSQL ----------
POSTGRES_DB=swiftdrop
POSTGRES_USER=postgres
# Superuser password (only used by the init script and for admin access)
POSTGRES_PASSWORD=
# One login per service; each owns its own schema
# (auth, parcel, dispatch, merchant, notification, realtime, reporting, ai).
# The init script only runs on an empty volume: after adding a schema, run `docker compose down -v` once.
AUTH_DB_PASSWORD=
PARCEL_DB_PASSWORD=
DISPATCH_DB_PASSWORD=
MERCHANT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
REALTIME_DB_PASSWORD=
REPORTING_DB_PASSWORD=
AI_DB_PASSWORD=

# ---------- RabbitMQ (management UI: http://localhost:15672) ----------
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=

# ---------- Auth: JWT ----------
# RS256 keypair as base64-encoded PEM (private key in PKCS#8). Generated by scripts/dev-keys.sh.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Issuer written into tokens and checked by every service
JWT_ISSUER=http://auth-service:8081
# ISO-8601 durations. Set JWT_ACCESS_TTL=PT1M to test silent refresh.
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# ---------- Auth: PII encryption ----------
# Base64 of 32 random bytes (AES-256-GCM key for phone numbers and the OAuth state cookie)
PII_ENCRYPTION_KEY=

# ---------- Auth: cookies and web app ----------
# true in production (HTTPS only cookies)
COOKIE_SECURE=false
# Public URL of the web app; Google redirects back to ${WEB_APP_URL}/api/v1/auth/oauth2/callback/google
WEB_APP_URL=http://localhost:3000

# ---------- Auth: Google OAuth (optional for local dev) ----------
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Service-to-service calls ----------
# Shared secret sent as X-Internal-Token on /internal/** calls between services. Generated by dev-keys.sh.
INTERNAL_TOKEN=

# ---------- MinIO: delivery proof photos (S3 API http://localhost:9000) ----------
MINIO_ROOT_USER=swiftdrop
# Generated by dev-keys.sh (at least 8 characters)
MINIO_ROOT_PASSWORD=
# Created on startup; dispatch-service stores courier photos here
MINIO_BUCKET_PROOFS=proofs

# ---------- Mailpit: test inbox for every email (web UI http://localhost:8025) ----------
# notification-service sends SMTP to mailpit:1025; nothing ever leaves your machine.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@swiftdrop.test

# ---------- Merchant webhooks ----------
# Delay before each retry of a failed webhook, as ISO-8601 durations. Real values: PT1M,PT5M,PT30M,PT2H.
# The demo uses short ones so the dead-letter step is visible on stage.
WEBHOOK_RETRY_DELAYS=PT5S,PT10S,PT20S,PT40S

# ---------- AI assistant (optional) ----------
# API key for the assistant's LLM. Leave empty and the assistant returns a fixed friendly reply.
LLM_API_KEY=

# ---------- Demo Store (http://localhost:4000) ----------
# Merchant API key the Demo Store sends as X-API-Key. Filled in by the demo seed step.
DEMO_STORE_API_KEY=
# Secret the Demo Store uses to check webhook signatures. Shown once when the webhook is registered.
DEMO_STORE_WEBHOOK_SECRET=

# ---------- Demo data ----------
# true creates one account per role on startup (admin@swiftdrop.test, ...). Never enable in production.
SEED_DEMO_DATA=true
# Password for every seeded account (dev-keys.sh generates one and prints it)
SEED_PASSWORD=
